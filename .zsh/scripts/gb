#!/usr/bin/env python3

import re
import subprocess
import sys


def git(*args):
    return subprocess.run(
        ["git", *args],
        text=True,
        capture_output=True,
        check=False,
    )


def recent_branches(limit):
    result = git("reflog", "--format=%gs")

    if result.returncode != 0:
        print(result.stderr, end="")
        return []

    branches = []

    for line in result.stdout.splitlines():
        match = re.search(r"checkout: moving .* to (.+)$", line)
        if match:
            branch = match.group(1)
            if branch not in branches:
                branches.append(branch)

        if len(branches) == limit:
            break

    return branches


def checkout(branch):
    result = git("checkout", branch)

    if result.returncode != 0:
        print(result.stderr, end="")
        return result.returncode

    return 0


def choose(branches, remote_flags):
    for i, (branch, is_remote) in enumerate(
        zip(branches, remote_flags), start=1
    ):
        suffix = " (remote)" if is_remote else ""
        print(f"  {i}) {branch}{suffix}")

    print()
    print("Switch to branch (number, or Esc to cancel): ", end="", flush=True)

    import sys
    import termios
    import tty

    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)

    try:
        tty.setraw(fd)
        key = sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)

    print()

    if key == "\x1b":  # Escape
        return 0

    if not key.isdigit():
        print("Invalid selection.")
        return 1

    index = int(key) - 1

    if not 0 <= index < len(branches):
        print("Invalid selection.")
        return 1

    return checkout(branches[index])

def switch_last():
    branches = recent_branches(2)

    if len(branches) < 2:
        print("No previous branch found.")
        return 1

    return checkout(branches[1])


def switch_or_search(query):
    print("Fetching remotes...")
    result = git("fetch", "--all", "-q")

    if result.returncode != 0:
        print(result.stderr, end="")
        return result.returncode

    query_lower = query.lower()

    # git branch --format avoids parsing the decorative "* main" output.
    result = git("branch", "--format=%(refname:short)")

    if result.returncode != 0:
        print(result.stderr, end="")
        return result.returncode

    local = [
        branch
        for branch in result.stdout.splitlines()
        if query_lower in branch.lower()
    ]

    result = git(
        "branch",
        "-r",
        "--format=%(refname:short)",
    )

    if result.returncode != 0:
        print(result.stderr, end="")
        return result.returncode

    remote = [
        branch.removeprefix("origin/")
        for branch in result.stdout.splitlines()
        if " -> " not in branch
        and query_lower in branch.lower()
    ]

    branches = [(branch, False) for branch in local]

    local_set = set(local)

    branches.extend(
        (branch, True)
        for branch in remote
        if branch not in local_set
    )

    if not branches:
        print(f"No branches found matching '{query}'.")
        return 1

    if len(branches) == 1:
        branch, is_remote = branches[0]

        if is_remote:
            # Equivalent to `git checkout branch`, which creates a
            # tracking branch when origin/branch exists.
            return checkout(branch)

        return checkout(branch)

    return choose(
        [branch for branch, _ in branches],
        [is_remote for _, is_remote in branches],
    )


def main():
    args = sys.argv[1:]

    if args and args[0] == "-":
        return switch_last()

    if args:
        return switch_or_search(args[0])

    branches = recent_branches(5)

    if not branches:
        print("No recent branches found.")
        return 1

    return choose(branches, [False] * len(branches))


if __name__ == "__main__":
    sys.exit(main())